// ตรวจสอบการ login
if (!isset($_SESSION['user_id']) || $_SESSION['user_type'] != 'student') {
    header("Location: login.php");
    exit();
}

$std_id = $_SESSION['user_id'];
$page = isset($_GET['page']) ? $_GET['page'] : 'dashboard';

// ดึงข้อมูลนักเรียน
$sql = "SELECT * FROM tb_student WHERE std_id = '$std_id'";
$result = $conn->query($sql);
$student = $result->fetch_assoc();

// ดึงข้อมูลการฝึกงาน
$sql_internship = "SELECT i.*, c.com_name FROM tb_internship i 
                   LEFT JOIN tb_company c ON i.com_id = c.com_id 
                   WHERE i.std_id = '$std_id' ORDER BY i.created_at DESC";
$internship_result = $conn->query($sql_internship);

// ดึงข้อมูลบริษัท
$sql_company = "SELECT * FROM tb_company ORDER BY com_name ASC";
$company_result = $conn->query($sql_company);

// ดึงข้อมูลสาขา
$sql_department = "SELECT * FROM tb_department ORDER BY dep_name ASC";
$department_result = $conn->query($sql_department);

// จัดการการสมัครฝึกงาน
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['action'])) {
    if ($_POST['action'] == 'apply') {
        $com_id = $_POST['com_id'];
        $start_date = $_POST['start_date'];
        $end_date = $_POST['end_date'];
        
        $sql_insert = "INSERT INTO tb_internship (std_id, com_id, start_date, end_date, status) 
                       VALUES ('$std_id', '$com_id', '$start_date', '$end_date', 'pending')";
        
        if ($conn->query($sql_insert)) {
            $_SESSION['success'] = "สมัครฝึกงานเรียบร้อย รอการอนุมัติจากผู้ดูแลระบบ";
            header("Location: student_dashboard.php?page=internship");
            exit();
        } else {
            $_SESSION['error'] = "เกิดข้อผิดพลาด: " . $conn->error;
        }
    }
    
    if ($_POST['action'] == 'update_profile') {
        $std_name = $_POST['std_name'];
        $std_add = $_POST['std_add'];
        $std_tel = $_POST['std_tel'];
        $std_gmail = $_POST['std_gmail'];
        
        $sql_update = "UPDATE tb_student SET std_name='$std_name', std_add='$std_add', 
                       std_tel='$std_tel', std_gmail='$std_gmail' WHERE std_id='$std_id'";
        
        if ($conn->query($sql_update)) {
            $_SESSION['success'] = "อัปเดตข้อมูลเรียบร้อย";
            header("Location: student_dashboard.php?page=profile");
            exit();
        } else {
            $_SESSION['error'] = "เกิดข้อผิดพลาด: " . $conn->error;
        }
    }
}

